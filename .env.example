# PostgreSQL
DATABASE_URL="postgresql://creatin:creatin@localhost:5432/creatin_world?schema=public"

# App
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_COOKIE_SECURE="false"

# Telegram Login
# In production set TELEGRAM_AUTH_BYPASS=false and configure the bot username/token.
TELEGRAM_BOT_USERNAME="creatin_world_dev_bot"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_AUTH_BYPASS="true"
TELEGRAM_ADMIN_IDS=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="creatin_world_dev_bot"

# Скрытый публичный путь к админ-панели вместо /admin (без слэшей). Смените на своё значение.
NEXT_PUBLIC_ADMIN_PANEL_PATH="cw-console-74x2"

# Feature flags: stage 1 keeps everything open by default.
FEATURE_PAYMENTS_REQUIRED="false"
FEATURE_MODERATION_REQUIRED="false"
FEATURE_AI_EXTERNAL_REQUIRED="false"

# Direct OpenAI integration for top-3 creators.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6"

# Optional custom AI provider compatible with the payload documented in README.
# Used only when OPENAI_API_KEY is empty.
AI_API_ENDPOINT=""
AI_API_KEY=""
AI_API_MODEL="creatin-top3"

# If neither provider is configured, the app uses a deterministic local fallback.

# File storage
FILE_STORAGE_DRIVER="local"
FILE_STORAGE_PATH="./uploads"

# Test payment provider
PAYMENT_PROVIDER="test"

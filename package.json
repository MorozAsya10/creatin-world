{
  "name": "creatin-world-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack",
    "dev:turbo": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:creators": "node --env-file=.env --import tsx prisma/seed-creators.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "check": "prisma validate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "lucide-react": "0.468.0",
    "next": "16.2.12",
    "openai": "^7.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
